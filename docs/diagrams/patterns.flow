factory_2: umlclass "ConcreteFactory2 | | + createA()\n+ createB()" @ 78,559 54x30 [in=abstractfactory]
product_a: umlclass "«interface»\nProductA | | + use()" @ 164,501 58x30 [in=abstractfactory]
