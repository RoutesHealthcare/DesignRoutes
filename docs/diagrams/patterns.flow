concrete_command ..|> order
concrete_command ..> receiver : "calls action()"
about_13: text "Command: turn a request into an object. Use it to queue, log, schedule or undo actions, as an editor's undo stack or a job queue does." @ 16,1209 148x13 [in=command]

state: container "State" @ 190,1097 160x129
context_2: umlclass "Context | - state: State | + request()" @ 196,1111 58x32 [in=state]
current: umlclass "«interface»\nState | | + handle(context)" @ 286,1111 58x30 [in=state]
state_a: umlclass "ConcreteStateA | | + handle(context)" @ 254,1167 44x32 [in=state]
state_b: umlclass "ConcreteStateB | | + handle(context)" @ 302,1167 44x32 [in=state]
context_2 o-- current : "current"
state_a ..|> current
state_b ..|> current
about_14: text "State: an object changes its behaviour when its state changes, by handing work to a state object. Use it instead of state checks in every method: orders, connections, game characters, media players." @ 196,1205 148x17 [in=state]

template: container "Template Method" @ 10,1246 160x133
abstract: umlclass "AbstractClass | | + templateMethod()\n# step1()\n# step2()" @ 54,1258 70x40 [in=template]
concrete_a: umlclass "ConcreteClassA | | # step1()\n# step2()" @ 16,1320 64x30 [in=template]
concrete_b: umlclass "ConcreteClassB | | # step1()\n# step2()" @ 100,1320 64x30 [in=template]
concrete_a --|> abstract
concrete_b --|> abstract
about_15: text "Template Method: a base class fixes the outline of an algorithm and leaves some steps to subclasses. Use it when several classes share the same overall process but differ in a few steps." @ 16,1358 148x17 [in=template]

iterator: container "Iterator" @ 190,1246 160x131
collection: umlclass "«interface»\nAggregate | | + createIterator(): Iterator" @ 196,1260 64x30 [in=iterator]
cursor: umlclass "«interface»\nIterator | | + hasNext(): bool\n+ next(): Item" @ 286,1258 58x36 [in=iterator]
concrete_collection: umlclass "ConcreteAggregate | - items | + createIterator()" @ 196,1318 64x34 [in=iterator]
concrete_cursor: umlclass "ConcreteIterator | - index | + hasNext()\n+ next()" @ 286,1316 58x38 [in=iterator]
concrete_collection ..|> collection
concrete_cursor ..|> cursor
concrete_collection ..> concrete_cursor : "creates"
about_16: text "Iterator: step through a collection without knowing how it is stored. Use it so the same loop works on lists, trees and streams; it's what for-each loops are built on." @ 196,1360 148x13 [in=iterator]

chain: container "Chain of Responsibility" @ 10,1399 160x141
client_6: umlclass "Client | | + send(request)" @ 16,1415 44x26 [in=chain]
