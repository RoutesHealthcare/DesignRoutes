compare: decision "list[j] > list[j + 1]?" @ 74,331 48x22 [in=bubble]
swap: process "swap them\nswapped = true" @ 146,334 44x16 [in=bubble]
step: process "j = j + 1" @ 74,363 48x14 [in=bubble]
