about_11: text "Composite: build trees of objects and treat a group exactly like a single item. Use it for files and folders, shapes in a drawing, menus within menus." @ 16,1060 148x13 [in=composite]

proxy: container "Proxy" @ 190,946 162x131
client_5: umlclass "Client | | + run()" @ 196,962 40x26 [in=proxy]
