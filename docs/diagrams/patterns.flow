humid: decision "Humid?" @ 24,707 44x18 [in=tree]
overcast_play: terminator "Play" @ 79,711 32x12 [in=tree fill=#D9EAD3]
windy: decision "Windy?" @ 122,707 44x18 [in=tree]
humid_no: terminator "Stay in" @ 14,741 30x12 [in=tree fill=#F4CCCC]
humid_play: terminator "Play" @ 48,741 26x12 [in=tree fill=#D9EAD3]
windy_no: terminator "Stay in" @ 116,741 30x12 [in=tree fill=#F4CCCC]
windy_play: terminator "Play" @ 150,741 26x12 [in=tree fill=#D9EAD3]
outlook -> humid : "sunny"
outlook -> overcast_play : "overcast"
outlook -> windy : "rain"
humid -> humid_no : "yes"
humid -> humid_play : "no"
windy -> windy_no : "yes"
windy -> windy_play : "no"
about_7: text "Decision tree: a series of yes/no questions about the data, each answer a branch, ending in a decision. Easy to read and explain; many trees together make random forests and gradient boosting." @ 16,763 158x13 [in=tree]

kmeans: container "k-means clustering" @ 10,800 202x147
start_2: terminator "Points, k" @ 26,812 44x12 [in=kmeans]
init: process "Pick k centres\nat random" @ 26,830 44x16 [in=kmeans]
assign: process "Give each point to\nits nearest centre" @ 26,854 44x16 [in=kmeans]
move: process "Move each centre to\nits points' middle" @ 26,878 44x16 [in=kmeans]
changed: decision "Any point\nchanged centre?" @ 26,902 44x20 [in=kmeans]
done_2: terminator "k clusters" @ 80,905 32x14 [in=kmeans]
points: scatter "Three clusters" { 2, 3; 3, 2; 2.5, 4; 3.5, 3; 7, 8; 8, 7; 7.5, 9; 8.5, 8; 8, 2; 9, 3; 7.5, 1.5; 9, 2 } @ 120,814 86x80 [in=kmeans]
start_2 -> init
init -> assign
assign -> move
move -> changed
changed -> assign [route=elbow beginpt=w endpt=w] : "yes"
changed -> done_2 : "no"
about_8: text "k-means clustering: split data into k groups by giving each point to its nearest centre, then moving each centre to the middle of its points, until nothing changes. Used for customer segments and grouping." @ 16,930 190x13 [in=kmeans]

confusion: container "Confusion matrix" @ 10,967 150x87
corner: process "" @ 16,981 38x8 [in=confusion fill=#E8EDF2]
pred_yes: process "Predicted yes" @ 54,981 50x8 [in=confusion fill=#E8EDF2]
pred_no: process "Predicted no" @ 104,981 50x8 [in=confusion fill=#E8EDF2]
act_yes: process "Actually yes" @ 16,989 38x10 [in=confusion fill=#E8EDF2]
tp: process "40 true positives" @ 54,989 50x10 [in=confusion fill=#D9EAD3]
fn: process "10 false negatives" @ 104,989 50x10 [in=confusion fill=#F4CCCC]
act_no: process "Actually no" @ 16,999 38x10 [in=confusion fill=#E8EDF2]
fp: process "5 false positives" @ 54,999 50x10 [in=confusion fill=#F4CCCC]
tn: process "45 true negatives" @ 104,999 50x10 [in=confusion fill=#D9EAD3]
scores: text "Accuracy 85%: (40 + 45) ÷ 100.  Precision 89%: 40 ÷ 45.  Recall 80%: 40 ÷ 50." @ 16,1015 138x12 [in=confusion]
about_9: text "Confusion matrix: a model's predictions against the truth, as right and wrong yeses and noes. Accuracy, precision and recall all come from it. Use it to judge any classifier, especially when one class is rare." @ 16,1033 138x17 [in=confusion]

pipeline: container "Machine learning pipeline" @ 10,1074 244x71
data: database "Raw data" @ 16,1090 24x24 [in=pipeline]
clean: process "Clean and\nlabel" @ 46,1093 28x18 [in=pipeline]
features: process "Features" @ 80,1093 28x18 [in=pipeline]
split: process "Split: train,\nvalidation, test" @ 114,1093 34x18 [in=pipeline]
train: process "Train" @ 154,1093 22x18 [in=pipeline]
evaluate: decision "Good\nenough?" @ 182,1090 28x24 [in=pipeline]
deploy: terminator "Deploy" @ 222,1096 26x14 [in=pipeline fill=#D9EAD3]
data -> clean
clean -> features
features -> split
split -> train
train -> evaluate
evaluate -> deploy : "yes"
evaluate -alt-> features [route=elbow beginpt=s endpt=s] : "no: rework the features"
about_10: text "A machine learning pipeline: the steps from raw data to a model in use. Most of the work is in the data, and the loop back from evaluation is where models get better. MLOps tools run it." @ 16,1128 232x13 [in=pipeline]

rnn: container "Recurrent network (RNN / LSTM)" @ 10,1165 164x125
y1_2: ellipse "y1" @ 30,1177 16x12 [in=rnn fill=#D9EAD3]
y2_2: ellipse "y2" @ 80,1177 16x12 [in=rnn fill=#D9EAD3]
y3: ellipse "y3" @ 130,1177 16x12 [in=rnn fill=#D9EAD3]
h1_2: process "cell" @ 24,1203 28x16 [in=rnn fill=#FDE7C8]
h2_2: process "cell" @ 74,1203 28x16 [in=rnn fill=#FDE7C8]
h3_2: process "cell" @ 124,1203 28x16 [in=rnn fill=#FDE7C8]
x1_2: ellipse "The" @ 28,1233 20x12 [in=rnn fill=#DCE3EB]
x2_2: ellipse "cat" @ 78,1233 20x12 [in=rnn fill=#DCE3EB]
x3_2: ellipse "sat" @ 128,1233 20x12 [in=rnn fill=#DCE3EB]
note: text "The same cell, step by step. An LSTM cell adds gates to keep or forget." @ 16,1251 152x12 [in=rnn]
x1_2 -> h1_2
x2_2 -> h2_2
x3_2 -> h3_2
h1_2 -> y1_2
h2_2 -> y2_2
h3_2 -> y3
h1_2 -> h2_2 : "state"
h2_2 -> h3_2 : "state"
about_11: text "Recurrent neural network: one cell reads a sequence a step at a time, passing a state on to the next step as its memory. An LSTM's gates let it remember for longer. Used for text, speech and time series, before transformers." @ 16,1269 152x17 [in=rnn]

autoencoder: container "Autoencoder" @ 10,1310 190x97
input_2: process "Input\n784" @ 16,1324 26x56 [in=autoencoder fill=#DCE3EB]
encoder: process "Encoder" @ 54,1334 26x36 [in=autoencoder fill=#FDE7C8]
code: process "Code\n32" @ 92,1344 26x16 [in=autoencoder fill=#D9EAD3]
decoder: process "Decoder" @ 130,1334 26x36 [in=autoencoder fill=#FDE7C8]
output: process "Rebuilt\n784" @ 168,1324 26x56 [in=autoencoder fill=#DCE3EB]
input_2 -> encoder
encoder -> code
code -> decoder
decoder -> output
about_12: text "Autoencoder: a network trained to rebuild its own input through a small middle layer, so that layer learns a compact code. Used for compression, removing noise and spotting unusual data: a bad rebuild means unusual input." @ 16,1386 178x17 [in=autoencoder]

rl: container "Reinforcement learning loop" @ 10,1427 180x123
agent: process "Agent\nits policy picks" @ 24,1461 48x20 [in=rl fill=#FDE7C8]
environment: process "Environment\ngame, robot, market" @ 128,1461 48x20 [in=rl fill=#DCE3EB]
learn: process "Learn: do more of\nwhat earned reward" @ 94,1505 48x16 [in=rl fill=#D9EAD3]
agent -> environment [route=elbow beginpt=n endpt=n] : "action"
environment -> learn [route=elbow beginpt=s endpt=e] : "new state, reward"
learn -> agent [route=elbow beginpt=w endpt=s]
about_13: text "Reinforcement learning: an agent learns by trial and error. It acts, the environment answers with a new state and a reward, and it learns to choose actions that earn the most reward over time. Used for games, robots and tuning LLMs." @ 16,1529 168x17 [in=rl]

curves: container "Training and validation curves" @ 10,1570 172x113
chart: line "Loss per epoch" { 9, 6, 4.2, 3, 2.2, 1.6, 1.1, 0.8; 9.4, 6.8, 5, 4.1, 3.8, 3.9, 4.3, 4.9 } @ 16,1584 90x64 [in=curves colours=#2B3A47,#C4741E]
key_row: legendrow "Training | Validation" @ 16,1650 90x8 [in=curves colours=#2B3A47,#C4741E]
train_2: process "Train 70%:\nlearn the weights" @ 114,1584 62x14 [in=curves fill=#DCE3EB]
val: process "Validate 15%:\ntune, pick when to stop" @ 114,1602 62x14 [in=curves fill=#FDE7C8]
test: process "Test 15%:\nthe final score" @ 114,1620 62x14 [in=curves fill=#D9EAD3]
note_2: text "Validation loss rises after epoch 5: overfitting." @ 114,1638 62x16 [in=curves]
about_14: text "Training and validation curves: loss on the training data and on held-back data, epoch by epoch. When validation loss turns up while training loss still falls, the model is overfitting. Used to choose when to stop training." @ 16,1662 160x17 [in=curves]
