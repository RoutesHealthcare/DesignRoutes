factory_2 ..|> abstract_factory
product_a1 ..|> product_a
product_a2 ..|> product_a
abstract_factory ..> product_a : "makes"
about_7: text "Abstract Factory: one factory per family of related products, so the products always match each other. Use it for themes, platforms or database drivers, where mixing families would break things." @ 16,597 224x13 [in=abstractfactory]

builder: container "Builder" @ 10,634 160x145
director: umlclass "Director | - builder: Builder | + construct()" @ 16,648 58x32 [in=builder]
