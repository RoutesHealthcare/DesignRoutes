handler_b --|> handler
about_17: text "Chain of Responsibility: pass a request along a chain of handlers until one deals with it. Use it for middleware, event bubbling, support tiers and approval rules." @ 16,1523 148x13 [in=chain]

visitor: container "Visitor" @ 190,1399 160x135
element: umlclass "«interface»\nElement | | + accept(v: Visitor)" @ 196,1413 58x30 [in=visitor]
