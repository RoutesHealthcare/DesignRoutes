training: container "Training loop" @ 170,10 190x203
start: terminator "Data, and a model\nwith random weights" @ 234,22 52x16 [in=training]
batch: process "Take a batch" @ 234,46 52x14 [in=training]
forward: process "Forward pass:\nmake predictions" @ 234,68 52x16 [in=training]
loss: process "Loss: how wrong\nthe predictions are" @ 234,92 52x16 [in=training]
backward: process "Backward pass:\nwork out gradients" @ 234,116 52x16 [in=training]
update: process "Update the weights:\nw = w − rate × gradient" @ 234,140 52x16 [in=training]
more: decision "More epochs?" @ 234,164 52x22 [in=training]
done: terminator "Trained model" @ 176,167 44x16 [in=training]
start -> batch
batch -> forward
forward -> loss
loss -> backward
backward -> update
update -> more
more -> batch [route=elbow beginpt=e endpt=e] : "yes"
more -> done : "no"
about_2: text "The training loop: how a model learns. Show it a batch, measure how wrong it was, work out which way to nudge each weight, nudge them, repeat. One pass over all the data is an epoch." @ 176,196 178x13 [in=training]

descent: container "Gradient descent" @ 10,233 170x103
curve: line "Loss, step by step" { 9, 6.2, 4.3, 3, 2.1, 1.5, 1.1, 0.9 } @ 16,247 80x64 [in=descent]
step: process "w = w − rate × ∂L/∂w" @ 106,249 68x16 [in=descent fill=#DCE3EB]
notes: text "Each step moves the weights a little downhill on the loss. Too big a rate overshoots the bottom; too small takes for ever." @ 106,271 68x36 [in=descent]
about_3: text "Gradient descent: find the weights with the lowest loss by repeatedly stepping downhill, against the gradient. The learning rate sets the step size. It trains almost every neural network." @ 16,319 158x13 [in=descent]

backprop: container "Backpropagation" @ 10,356 230x97
input: process "Input x" @ 16,386 30x20 [in=backprop]
layer_1: process "Layer 1\nh1 = f(W1 x)" @ 74,386 36x20 [in=backprop]
layer_2: process "Layer 2\nh2 = f(W2 h1)" @ 138,386 36x20 [in=backprop]
loss_2: process "Loss L" @ 202,386 30x20 [in=backprop fill=#F6B26B]
input -> layer_1 [beginpt=e@0.3 endpt=w@0.3] : "forward"
layer_1 -> layer_2 [beginpt=e@0.3 endpt=w@0.3]
layer_2 -> loss_2 [beginpt=e@0.3 endpt=w@0.3]
loss_2 ..> layer_2 [beginpt=w@0.75 endpt=e@0.75] : "∂L/∂h2"
layer_2 ..> layer_1 [beginpt=w@0.75 endpt=e@0.75] : "∂L/∂h1"
rule_2: text "Forward: work out the prediction and the loss. Backward: the chain rule passes the gradient of the loss back, layer by layer, to every weight." @ 16,414 218x14 [in=backprop]
about_4: text "Backpropagation: work out how much each weight contributed to the error, by passing the loss's gradient backwards through the layers with the chain rule. It is how neural networks get their gradients." @ 16,436 218x13 [in=backprop]

