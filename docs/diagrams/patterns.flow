about_12: text "Proxy: a stand-in with the same interface as the real object, which controls access to it. Use it to load something only when needed, check permissions, cache, or talk to a remote object." @ 196,1056 150x17 [in=proxy]

command: container "Command" @ 10,1097 160x129
invoker: umlclass "Invoker | - command: Command | + run()" @ 16,1111 58x32 [in=command]
