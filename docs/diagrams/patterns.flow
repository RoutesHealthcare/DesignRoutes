hit: decision "list[mid] = target?" @ 74,120 48x20 [in=bsearch]
lower: decision "list[mid] < target?" @ 74,150 48x20 [in=bsearch]
right_half: process "low = mid + 1" @ 146,152 44x16 [in=bsearch]
left_half: process "high = mid − 1" @ 74,180 48x16 [in=bsearch]
found: terminator "Found at mid" @ 16,123 44x14 [in=bsearch]
missing: terminator "Not found" @ 16,71 40x14 [in=bsearch]
