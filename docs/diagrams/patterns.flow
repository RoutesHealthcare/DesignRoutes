handler_b: umlclass "HandlerB | | + handle(request)" @ 122,1471 44x30 [in=chain]
passing: text "A request goes along the chain, A then B then the next, until one handles it." @ 16,1507 148x10 [in=chain]
client_6 ..> handler : "handle()"
