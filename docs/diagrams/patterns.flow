rule_3: text "Convolutions find local features with small shared filters; pooling shrinks the map; dense layers decide." @ 16,517 190x12 [in=cnn]
image -> conv_1
conv_1 -> pool_1
pool_1 -> conv_2
conv_2 -> pool_2
pool_2 -> dense
dense -> classes
about_5: text "Convolutional neural network: small filters slide over an image to find edges, then shapes, then objects, with pooling shrinking the image between. The standard network for images and video." @ 16,537 190x13 [in=cnn]

transformer: container "Transformer block" @ 232,473 120x172
tokens: process "Token embeddings\n+ positions" @ 262,485 60x16 [in=transformer fill=#DCE3EB]
attention: process "Multi-head\nself-attention" @ 262,509 60x16 [in=transformer fill=#FDE7C8]
norm_1: process "Add & norm" @ 262,533 60x14 [in=transformer]
feed: process "Feed-forward" @ 262,555 60x14 [in=transformer fill=#FCE5CD]
norm_2: process "Add & norm" @ 262,577 60x14 [in=transformer]
next: text "to the next block" @ 262,601 60x8 [in=transformer]
tokens -> attention
attention -> norm_1
norm_1 -> feed
feed -> norm_2
norm_2 -> next
tokens -> norm_1 [route=elbow beginpt=e endpt=e@0.3] : "skip"
norm_1 -> norm_2 [route=elbow beginpt=e@0.7 endpt=e] : "skip"
about_6: text "Transformer block: self-attention lets every token look at every other token, then a feed-forward layer works on each one; skip connections and normalisation keep it stable. Stacked, it is the basis of LLMs." @ 238,619 108x22 [in=transformer]

