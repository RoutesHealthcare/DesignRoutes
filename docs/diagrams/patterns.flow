concrete_builder ..> product_2 : "builds"
about_8: text "Builder: put a complex object together step by step, with the same steps able to make different results. Use it for objects with many optional parts, such as queries, documents or HTTP requests." @ 16,758 148x17 [in=builder]

prototype: container "Prototype" @ 190,634 160x125
