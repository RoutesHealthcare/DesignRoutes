about_10: text "Facade: one simple class in front of a complicated subsystem. Use it to give the common tasks an easy door, while the subsystem stays there for anyone who needs more." @ 16,909 190x13 [in=facade]

composite: container "Composite" @ 10,946 160x131
component_2: umlclass "«interface»\nComponent | | + operation()" @ 60,960 58x30 [in=composite]
leaf: umlclass "Leaf | | + operation()" @ 16,1012 58x30 [in=composite]
