element ..> guest : "accepts"
element_a ..|> element
element_b ..|> element
concrete_visitor ..|> guest
about_18: text "Visitor: add new operations to a set of classes without changing them, by putting each operation in a visitor. Use it for compilers and document exporters: many operations over a fixed set of node types." @ 196,1513 148x17 [in=visitor]

injection: container "Dependency Injection" @ 10,1560 160x133
injector: umlclass "Injector | | + build(): Client" @ 16,1574 52x26 [in=injection]
