# ---------------------------------------------------------------------------
page "2. Before committing"

docs: process "Run the docs tests\nnpx playwright test\n--project=docs" @ 10,20 44x22
rewritten: document "Rewritten:\npatterns.flow + PNG,\neditor.png (Id field),\nevery docs PNG" @ 66,18 46x28
big: decision "patterns.flow now holds\n112 patterns. All of them\nin the skill's examples?" @ 124,14 60x36
split: process "Split it: patterns.flow for\nUI patterns, code-patterns.flow\nfor the rest (images.spec.js)" @ 124,66 60x24
skill: process "Rebuild the skill\nnode scripts/\nbuild-flow-skill.mjs" @ 206,20 44x22
build: process "npm run build\n(dist is tracked)" @ 206,56 44x16
tests: process "npm test\nboth builds" @ 206,84 44x16
review: process "Review the\nwhole diff" @ 206,112 44x16
commit: terminator "Commit on\nreact-migration" @ 206,140 44x16

docs -> rewritten
rewritten -> big
big -> skill : "yes"
big -> split : "no: ~1000 lines\nin examples.md"
split -> skill
skill -> build
build -> tests
tests -> review
review -> commit

flaky: callout "Under a full parallel run a few tests\ntime out at 30 s (mind map drag, PNG/PDF\nexport, container drags) and pass when\nrun alone. Worth a look: fewer workers,\nor a longer timeout for those specs." @ 10,108 90x34

